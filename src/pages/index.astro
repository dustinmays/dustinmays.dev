---
import { execSync } from 'node:child_process';

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectBlock from '../components/ProjectBlock.astro';
import Mosaic from '../components/Mosaic.astro';
import Lightbox from '../components/Lightbox.astro';

import HeroCopy from '../content/hero.mdx';
import RipitCopy from '../content/aptx-ripit.mdx';
import AgentMinderCopy from '../content/aptx-agent-minder.mdx';
import OtNotesCopy from '../content/aptx-ot-notes.mdx';
import FreewaveCopy from '../content/background-freewave.mdx';
import OtIntroCopy from '../content/background-ot-intro.mdx';
import VcuCopy from '../content/background-vcu.mdx';
import LegProtectorCopy from '../content/background-leg-protector.mdx';
import AboutCopy from '../content/about.mdx';
import NowCopy from '../content/now.mdx';

// Last updated: ISO date of the most recent git commit at build time.
let lastUpdated = 'recently';
try {
  const iso = execSync('git log -1 --format=%cI', { encoding: 'utf-8' }).trim();
  lastUpdated = new Date(iso).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
  });
} catch {
  // Fallback if git isn't available at build time (shouldn't happen in CI).
}

const aptxMosaic = [
  {
    slug: 'ot-notes-shorthand-input',
    alt: 'The ot-notes input view: a clinician types raw session shorthand into a single freeform field. Synthetic demo data shown. Designed so clinicians can capture clinically rich notes without formatting overhead.',
    caption: 'ot-notes input view. Raw shorthand goes in. Synthetic demo data.',
    width: 780,
    height: 707,
  },
  {
    slug: 'ot-notes-generated-soap',
    alt: 'The ot-notes output view: the same session rendered into a formal SOAP-format Occupational Therapy Session Note, with client identifiers automatically replaced by [NAME REDACTED] placeholders.',
    caption: 'ot-notes output view. The same session as a SOAP note, identifiers redacted.',
    width: 780,
    height: 764,
  },
];

const backgroundMosaic = [
  {
    slug: 'leg-protector-pvc-prototype',
    alt: 'Early PVC prototype of the wheelchair leg-protector device, fitted on a client\'s chair during a clinical session. Subject\'s face anonymized. The frame uses standard PVC fittings with adjustable connectors, taped and labeled to test fit before refinement.',
    caption: 'Early PVC prototype. Cheap, ugly, fast to iterate on.',
    width: 780,
    height: 1040,
  },
  {
    slug: 'leg-protector-design-drawing',
    alt: 'Hand-drawn dimensioned design for the refined leg-protector frame, with side and front views. Annotations in red pen specify adjustable ranges and reference the wheelchair frame geometry it mounts to.',
    caption: 'Dimensioned design for the refined version.',
    width: 780,
    height: 1040,
  },
  {
    slug: 'leg-protector-in-use',
    alt: 'Former client using the finished leg-protector mounted to the front of his power wheelchair, several months after delivery. Subject\'s face anonymized. He reported the device gave him more confidence leaving the house.',
    caption: 'Former client using the finished device, several months in.',
    width: 780,
    height: 1387,
  },
];

const aboutMosaic = [
  {
    slug: 'metalwork-forged-arch',
    alt: 'Forged steel sculpture: an arched form with a textured disc top, hammered and surface-treated. Personal hobby project.',
    caption: 'Forged arch with a textured disc top. Blacksmithing class output.',
    width: 780,
    height: 877,
  },
];
---

<BaseLayout>
  {/* HERO — text only, no photo */}
  <section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name" class="display-xl">Dustin Mays</h1>

    <div class="prose body-large thesis">
      <HeroCopy />
    </div>

    <nav class="hero-links" aria-label="Primary contact">
      <a href="https://www.linkedin.com/in/dustin-mays-atot/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/dustinmays" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:drm2010.dustin@gmail.com">Email</a>
    </nav>
  </section>


  {/* APTX HEALTH */}
  <section aria-labelledby="aptx-heading">
    <h2 id="aptx-heading" class="display-l section-header">Aptx Health</h2>
    <p class="section-clarifier">Solo studio.</p>

    <ProjectBlock
      name="Ripit Fitness"
      status="Active"
      href="https://ripit.fit"
      hrefLabel="ripit.fit"
    >
      <RipitCopy />
    </ProjectBlock>

    <ProjectBlock
      name="agent-minder"
      status="Open source"
      href="https://github.com/aptx-health/agent-minder"
      hrefLabel="github.com/aptx-health/agent-minder"
    >
      <AgentMinderCopy />
    </ProjectBlock>

    <ProjectBlock
      name="ot-notes"
      status="Sunset 2025"
      href="https://github.com/aptx-health/ot-notes"
      hrefLabel="github.com/aptx-health/ot-notes"
    >
      <OtNotesCopy />
    </ProjectBlock>

    <Mosaic photos={aptxMosaic} label="ot-notes screenshots" />
  </section>


  {/* BEFORE APTX HEALTH */}
  <section aria-labelledby="background-heading">
    <h2 id="background-heading" class="display-l">Before Aptx Health</h2>

    <div class="prose background-block">
      <FreewaveCopy />
    </div>

    <div class="prose background-block">
      <OtIntroCopy />
    </div>

    <h3 class="display-m background-subhead">
      <a
        href="https://news.vcu.edu/article/They_created_a_computer_station__and_changed_a_quadriplegic_patients"
        target="_blank"
        rel="noopener noreferrer"
      >They created a computer station — and changed a quadriplegic patient&rsquo;s life</a>
    </h3>

    <div class="prose background-block">
      <VcuCopy />
    </div>

    <div class="prose background-block">
      <LegProtectorCopy />
    </div>

    <Mosaic photos={backgroundMosaic} label="Leg-protector iteration photos" />
  </section>


  {/* ABOUT */}
  <section aria-labelledby="about-heading">
    <h2 id="about-heading" class="display-l">About</h2>
    <div class="prose">
      <AboutCopy />
    </div>

    <Mosaic photos={aboutMosaic} label="Metalwork photo" />
  </section>

  {/* NOW */}
  <section aria-labelledby="now-heading">
    <h2 id="now-heading" class="display-l">Now</h2>
    <div class="prose now">
      <NowCopy />
    </div>
  </section>

  {/* FOOTER / COLOPHON */}
  <footer>
    <p>
      Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>, hosted on
      Cloudflare. Type set in Source Serif 4. Last updated {lastUpdated}.
      Source at <a href="https://github.com/dustinmays/dustinmays.dev" target="_blank" rel="noopener noreferrer">github.com/dustinmays/dustinmays.dev</a>.
    </p>
  </footer>

  <Lightbox />
</BaseLayout>
